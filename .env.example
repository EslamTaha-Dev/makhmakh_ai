# Shared Makhmakh configuration. Copy this file to `.env` at the repository root.
APP_NAME=makhmakh Backend
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:Postgres123!@localhost:5432/bosla

REDIS_URL=redis://localhost:6379/0
# Set true only when no RQ worker is deployed (for example Render Free).
RUN_JOBS_INLINE=false

# --- AI gateway -----------------------------------------------------------------
# Any OpenAI-compatible Chat Completions endpoint works. Examples:
# OpenRouter: https://openrouter.ai/api/v1
# OmniRouter: https://omnirouter.li/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=4096
LLM_API_KEY=
LLM_MODEL=

# Keep embeddings independently swappable because gateway support varies.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Used only when EMBEDDING_PROVIDER=sentence-transformers.
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

JWT_SECRET_KEY=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:3000
MFA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=100

# --- Frontend -------------------------------------------------------------------
# NEXT_PUBLIC_* values are intentionally exposed to the browser at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=100

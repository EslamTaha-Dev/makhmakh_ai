# Makhmakh backend configuration. Copy to `.env` and fill in the secrets.
APP_NAME=makhmakh Backend
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:Postgres123!@localhost:5432/bosla

REDIS_URL=redis://localhost:6379/0
# Set true only when no RQ worker is deployed (for example Render Free).
RUN_JOBS_INLINE=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
EMBEDDING_PROVIDER=gemini
ACTIVE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- AI gateway -----------------------------------------------------------------
# Provider used for every LLM call (gemini | openrouter).
AI_GATEWAY_PROVIDER=gemini
# Comma-separated Gemini keys. The individual names below also work, which is what
# the multi-project rotation described in 01-ai-gateway-api-keys.md expects.
GEMINI_API_KEYS=
GEMINI_API_KEY_DEV=
GEMINI_API_KEY_PROD_1=
GEMINI_API_KEY_PROD_2=
GEMINI_API_KEY_PROD_3=
OPENROUTER_API_KEY=
# Development/testing only. Keep false for the real demo.
MOCK_AI=false
# Seconds a key is parked after the provider reports a quota error.
AI_GATEWAY_COOLDOWN_SECONDS=60
AI_GATEWAY_MAX_RETRIES=4

JWT_SECRET_KEY=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_STARTTLS=true
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password
MFA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=100

PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_CHECKOUT_URL=

FAWRY_BASE_URL=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

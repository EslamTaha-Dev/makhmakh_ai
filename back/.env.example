# Makhmakh backend configuration. Copy to `.env` and fill in the secrets.
APP_NAME=makhmakh Backend
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://postgres:Postgres123!@localhost:5432/bosla

REDIS_URL=redis://localhost:6379/0
# Set true only when no RQ worker is deployed (for example Render Free).
RUN_JOBS_INLINE=false

EMBEDDING_PROVIDER=gemini
ACTIVE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- AI gateway -----------------------------------------------------------------
# Provider used for every LLM call (gemini | openrouter).
AI_GATEWAY_PROVIDER=gemini
# Configure one token for each provider you use.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Development/testing only. Keep false for the real demo.
MOCK_AI=false

JWT_SECRET_KEY=change-this-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:3000
MFA_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE_MB=100
